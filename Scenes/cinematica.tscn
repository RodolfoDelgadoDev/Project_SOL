scale = Vector2(4.625, 4.625)
dialogue_lines = Array[String](["[Wanda]¿¡Coli¡? ¡¡Coli!! ¿Me escuchas?", "[Coli] !!!", "[Wanda]Estamos encerrados en el depósito del Proyecto sol. Olga nos tendió una trampa a todos.Sé que estabas por llegar, pero aquí no te veo.", "[Coli]¿...?", "[Wanda]...¿Dimensión paralela? ¿Con...un cerdo? ¿Y plantas eléctricas?...Si no fueras Coli, diría que estás en un viaje extraño...", "...", "Espera.", "[sfx] beep!"])

